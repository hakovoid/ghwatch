{
  "interval": "1d",
  "state_file": "ghwatch-state.json",
  "reports_dir": "reports",
  "trend_window": "7d",
  "watches": [
    {
      "name": "IA & agents · nouveautés de la semaine",
      "any": [
        "topic:llm",
        "topic:ai-agents",
        "topic:claude-code",
        "topic:mcp",
        "topic:agent-skills",
        "topic:rag",
        "claude in:name,description",
        "agent in:name,description",
        "llm in:name,description"
      ],
      "created_within": "7d",
      "min_stars": 50,
      "limit": 15
    },
    {
      "name": "IA & agents · ce qui monte ce mois-ci",
      "any": [
        "topic:llm",
        "topic:ai-agents",
        "topic:claude-code",
        "topic:mcp"
      ],
      "created_within": "30d",
      "min_stars": 500,
      "limit": 10
    },
    {
      "name": "IA & agents · populaires et actifs",
      "any": [
        "topic:llm",
        "topic:ai-agents",
        "topic:claude-code",
        "topic:mcp",
        "topic:agent-skills"
      ],
      "pushed_within": "7d",
      "min_stars": 5000,
      "limit": 30
    },
    {
      "name": "Projets Go qui montent",
      "language": "go",
      "created_within": "30d",
      "min_stars": 100,
      "limit": 10
    },
    {
      "name": "Outils CLI récents",
      "query": "cli in:description",
      "created_within": "14d",
      "min_stars": 30,
      "limit": 5
    }
  ]
}
